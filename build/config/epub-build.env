# EPUBビルド設定ファイル
#
# build/epub.sh はこのファイルを起動時に読み込む。
# タイトル・出力先・しきい値などの文字列/数値リテラルはすべてここに
# 分離し、build/epub.sh 本体にハードコードしない。
#
# 値を変更したいときは、このファイルだけを編集すればよい
# （build/epub.sh の変更は不要）。

# --- EPUBメタデータ（Pandocに渡すYAML front matterの元データ） ---
EPUB_TITLE="差分で読むPython文法（デモ版）"
EPUB_SUBTITLE="他言語経験者のための最短ルート"
EPUB_AUTHOR="Ricta Works"
EPUB_LANGUAGE="ja"

# --- 入出力パス（すべてリポジトリルートからの相対パス） ---
MANUSCRIPT_DIR="manuscript"
STYLE_CSS_RELATIVE_PATH="styles/epub.css"
OUTPUT_DIR="build/output"
OUTPUT_FILENAME="python-syntax-diff-demo.epub"

# --- Pandoc変換オプション ---
PANDOC_SPLIT_LEVEL="1"
PANDOC_TARGET_FORMAT="epub3"

# --- コード桁数lint ---
LINT_CONFIG_RELATIVE_PATH="build/config/lint-width.json"
LINT_SCRIPT_RELATIVE_PATH="build/lint_code_width.py"

# --- EPUBCheck解決設定 ---
# Debian/Ubuntu の epubcheck パッケージは /usr/bin/epubcheck が
# 素のjarファイルへのシンボリックリンクになっており、そのままでは
# 実行できないことがある（シェバンなし）。そのため、まずjarパスを
# 明示的に指定して `java -jar` で起動することを優先する。
EPUBCHECK_JAR_PATH="/usr/share/java/epubcheck.jar"
